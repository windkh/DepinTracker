<Window x:Class="DepinTracker.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DepinTracker.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="DePIN Tracker" Height="720" Width="1140"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6F8">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Navigation rail -->
        <Border Grid.Column="0" Background="#1F2430">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="16,18,16,6">
                    <TextBlock Text="DePIN Tracker" Foreground="White" FontSize="18" FontWeight="Bold" />
                    <TextBlock Text="offline-first · portable" Foreground="#8A91A0" FontSize="11" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Top" Margin="16,0,16,14">
                    <!-- App-wide project scope: drives Dashboard / Transactions / Reports / Import. -->
                    <TextBlock Text="Project scope" Foreground="#8A91A0" FontSize="11" Margin="0,0,0,2" />
                    <ComboBox ItemsSource="{Binding AvailableScopes}"
                              SelectedItem="{Binding SelectedScope, Mode=TwoWay}"
                              DisplayMemberPath="Name" />
                </StackPanel>
                <ListBox x:Name="NavList"
                         Background="Transparent" BorderThickness="0" Foreground="White"
                         ItemsSource="{Binding Pages}"
                         SelectedItem="{Binding SelectedPage, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Title}" Padding="16,10" FontSize="14" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Active page + status bar -->
        <DockPanel Grid.Column="1">
            <Border DockPanel.Dock="Bottom" Background="#ECEEF1" BorderBrush="#D8DCE1" BorderThickness="0,1,0,0">
                <DockPanel Margin="12,6">
                    <TextBlock DockPanel.Dock="Right"
                               Text="Busy…" Foreground="#C0392B"
                               Visibility="{Binding SelectedPage.IsBusy, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding SelectedPage.StatusMessage}" Foreground="#444" TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Border>
            <ContentControl Content="{Binding SelectedPage}" Margin="6" />
        </DockPanel>
    </Grid>
</Window>
